{
  "name": "dsh-computers",
  "version": "1.0.0",
  "private": true,
  "description": "Connect your own machines to a DSH Web deployment and run commands on them from the agent.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "agent/*.mjs",
    "agent/*.md",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "PROTOCOL.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
