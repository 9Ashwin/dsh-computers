{
  "name": "dsh-computers",
  "version": "1.3.0",
  "description": "Connect your own machines to a DSH Web deployment and run commands on them from the agent.",
  "type": "module",
  "license": "MIT",
  "author": "9Ashwin",
  "homepage": "https://github.com/9Ashwin/dsh-computers#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/9Ashwin/dsh-computers.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "remote",
    "computers",
    "agents"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "agent/*.mjs",
    "agent/*.md",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "PROTOCOL.md",
    "README.md",
    "docs/*.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
